[Unit]
Description=OPTIMUS-THY FastAPI backend
After=network-online.target docker.service
Wants=network-online.target
# Corta el bucle si el arranque falla (importación, puerto ocupado, etc.).
StartLimitIntervalSec=60
StartLimitBurst=8

[Service]
Type=simple
WorkingDirectory=%h/code/optimus-thy-operativo/backend
ExecStart=%h/code/optimus-thy-operativo/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
KillMode=control-group
SuccessExitStatus=143
Environment=PYTHONUNBUFFERED=1
Environment=ALLOWED_ORIGINS=https://tiroides2.andresgaibor.com,http://localhost:5173,http://127.0.0.1:5173

[Install]
WantedBy=default.target
