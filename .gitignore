# Caché local de wrangler/cloudflared
.cloudflare/
# Índice de código y artefactos de pruebas
.codegraph/
playwright-report/
test-results/
**/__screenshots__/

# Fichas sintéticas generadas localmente (HT-091 a HT-093); se regeneran, no se commitean
backend/var/
var/fixtures-fichas/

# Herramientas y artefactos locales (no forman parte del producto)
.agents/
.wrangler/
mcp.json
frontend/.vitest-attachments/

# Releases and deployment metadata
releases/
deployments/
.deploy.lock
frontend/local:/
