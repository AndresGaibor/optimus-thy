# Secretos y entorno
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# Pesos de modelos y datos pesados
*.keras
*.h5
*.pt
*.pth
*.onnx
*.ckpt

