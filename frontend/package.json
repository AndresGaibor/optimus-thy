{
  "name": "@optimus-thy/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --project=app",
    "catalogo": "storybook dev -p 6104 --host 0.0.0.0 --no-open",
    "catalogo:build": "storybook build -o catalogo-static",
    "catalogo:test": "vitest run --project=storybook",
    "calidad:catalogo": "bun run catalogo:test",
    "catalogo:preview": "vite preview --outDir catalogo-static --host 0.0.0.0 --port 6105",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/api/schema.d.ts",
    "ui:check": "bun scripts/comprobar-ui.ts",
    "tamanos": "bun scripts/tamanos.ts",
    "calidad": "bun run ui:check && bun run tamanos",
    "capturar": "bun e2e/capturar.ts",
    "capturar:criticas": "bun e2e/capturar.ts --criticas --anchos 1440x900",
    "capturar:comparar": "bun e2e/capturar.ts --criticas --anchos 1440x900 --comparar",
    "consulta": "bun scripts/storybook-consulta.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "openapi-fetch": "^0.13.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-mcp": "10.6.6",
    "@storybook/addon-themes": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "^2",
    "openapi-typescript": "^7.4.4",
    "playwright": "1.65.0",
    "prettier": "^3.4.2",
    "react-docgen-typescript": "^2.4.0",
    "remark-gfm": "^4.0.1",
    "storybook": "10.6.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.3",
    "vitest": "4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
