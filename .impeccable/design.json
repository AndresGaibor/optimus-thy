      "css": ".ds-role-badge{display:inline-flex;align-items:center;gap:.375rem;padding:.125rem .625rem;border:1px solid color-mix(in oklab,var(--role-doctor) 30%,transparent);border-radius:9999px;background:color-mix(in oklab,var(--role-doctor) 10%,transparent);color:var(--role-doctor);font:600 .75rem/1rem system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}.ds-role-badge svg{width:.75rem;height:.75rem;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}"
    },
