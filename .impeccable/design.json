    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal de alto contraste.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Continuar</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.5rem;padding:.5rem 1rem;border:0;border-radius:var(--control-radius);background:var(--primary);color:var(--primary-foreground);font:500 .875rem/1.25rem system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;transition:color 150ms,background-color 150ms}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary) 90%,transparent)}.ds-button-primary:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Botón outline",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Acción secundaria con borde visible.",
      "html": "<button class=\"ds-button-outline\" type=\"button\">Cancelar</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.5rem;padding:.5rem 1rem;border:1px solid var(--input);border-radius:var(--control-radius);background:var(--background);color:var(--foreground);font:500 .875rem/1.25rem system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;transition:color 150ms,background-color 150ms}.ds-button-outline:hover{background:var(--border-subtle)}.ds-button-outline:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Campo de texto",
      "kind": "input",
      "refersTo": "field",
      "description": "Campo con borde, tamaño y foco coherentes.",
      "html": "<input class=\"ds-input\" type=\"text\" aria-label=\"Buscar\" placeholder=\"Buscar\">",
      "css": ".ds-input{width:100%;height:2.5rem;padding:.5rem .75rem;border:1px solid var(--input);border-radius:var(--control-radius);background:var(--background);color:var(--foreground);font:400 .875rem/1.25rem system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-input[aria-invalid=true]{border-color:var(--danger)}"
    },
    {
      "name": "Tarjeta",
      "kind": "card",
      "refersTo": "card",
      "description": "Contenedor principal de superficie con borde y elevación tenue.",
      "html": "<article class=\"ds-card\"><h2 class=\"ds-card__title\">Actividad reciente</h2><p>Resumen de demostración</p></article>",
      "css": ".ds-card{padding:1.5rem;border:1px solid var(--border);border-radius:var(--card-radius);background:var(--surface);color:var(--foreground);box-shadow:0 1px 3px 0 rgb(0 0 0 / .1),0 1px 2px -1px rgb(0 0 0 / .1)}.ds-card__title{margin:0 0 .75rem;font:600 1.125rem/1.25 system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;letter-spacing:-.025em}"
    },
    {
      "name": "Insignia de estado",
      "kind": "chip",
      "refersTo": "status-chip",
      "description": "Estado semántico con texto y tono redundante.",
      "html": "<span class=\"ds-status-chip\">Completado</span>",
      "css": ".ds-status-chip{display:inline-flex;align-items:center;gap:.25rem;padding:.125rem .625rem;border:1px solid color-mix(in oklab,var(--success) 30%,transparent);border-radius:9999px;background:color-mix(in oklab,var(--success) 10%,transparent);color:var(--success);font:600 .75rem/1rem system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}"
    },
