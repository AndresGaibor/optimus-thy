# OPTIMUS-THY — variables de entorno para desarrollo local.
# Copia este archivo a `.env` y ajusta los valores. NO uses secretos reales aquí.

# --- PostgreSQL ----------------------------------------------------------
# Credenciales del servicio `postgres` del compose. No exponer a Internet.
POSTGRES_USER=optimus
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=optimus

# Cadena completa que usa el backend (FastAPI + SQLAlchemy).
# Apunta al servicio interno `postgres` del compose, no a localhost.
DATABASE_URL=postgresql+psycopg://optimus:cambiar-en-local@postgres:5432/optimus

# --- Almacenamiento (MinIO, compatible con S3) --------------------------
# Endpoint interno del servicio `storage`. Solo accesible dentro de la red del compose.
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=cambiar-en-local
S3_SECRET_KEY=cambiar-en-local
S3_BUCKET=optimus
# Región de firma y vigencia de los enlaces de descarga (segundos, 60 a 86400).
S3_REGION=us-east-1
S3_PRESIGNED_SECONDS=3600


# --- Cifrado en reposo (HT-011) -----------------------------------------
# Clave de los datos personales de los pacientes. Nunca se sube al repo.
# Genera una propia con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Fuera de desarrollo el backend se niega a arrancar con el valor de ejemplo.
PII_ENCRYPTION_KEY=cambiar-en-local-no-usar-fuera-de-desarrollo

# --- Puertos publicados por el borde (nginx) -------------------------------
# Solo el proxy publica puertos al host. Cambia estos valores si hay colisión.
HTTP_PORT=8080
HTTPS_PORT=18443

# --- Aplicación ---------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- URLs internas de servicios OCR e IA --------------------------------
# El backend usa estas direcciones para llamarlos desde la red del compose.
OCR_URL=http://ocr:8001
IA_URL=http://ia:8002
