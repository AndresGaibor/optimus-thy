# OPTIMUS-THY — variables de entorno para desarrollo local.
# Copia este archivo a `.env` y ajusta los valores. NO uses secretos reales aquí.

# --- Identidad de despliegue (aislamiento) --------------------------------
# Define el proyecto Compose, prefijo de imágenes y red. En producción deben
# ser exactamente optimus-thy / optimus-thy / optimus-thy-net. Para e2e usa
# prefijo optimus-thy-e2e- (ver contrato de aislamiento).
DEPLOY_ENV=development
COMPOSE_PROJECT_NAME=optimus-thy
IMAGE_PREFIX=optimus-thy
COMPOSE_NETWORK=optimus-thy-net

# --- PostgreSQL ----------------------------------------------------------
# Credenciales del servicio `postgres` del compose. No exponer a Internet.
POSTGRES_USER=optimus
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=optimus

# Cadena completa que usa el backend (FastAPI + SQLAlchemy).
# Apunta al servicio interno `postgres` del compose, no a localhost.
DATABASE_URL=postgresql+psycopg://optimus:cambiar-en-local@postgres:5432/optimus

# --- Almacenamiento (MinIO, compatible con S3) --------------------------
# Endpoint interno del servicio `storage`. Solo accesible dentro de la red del compose.
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=cambiar-en-local
S3_SECRET_KEY=cambiar-en-local
S3_BUCKET=optimus
# Región de firma y vigencia de los enlaces de descarga (segundos, 60 a 86400).
S3_REGION=us-east-1
S3_PRESIGNED_SECONDS=3600
# Clave KMS de MinIO para SSE-S3, formato `nombre:base64(32 bytes)`. Cambiar en producción.
# Genera una propia con: python -c "import base64,secrets; print('optimus:'+base64.b64encode(secrets.token_bytes(32)).decode())"
MINIO_KMS_SECRET_KEY=optimus:b3B0aW11cy1kZXYta21zLWtleS0zMi1ieXRlcyEhISE=


# --- Cifrado en reposo (HT-011) -----------------------------------------
# Clave de los datos personales de los pacientes. Nunca se sube al repo.
# Genera una propia con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Fuera de desarrollo el backend se niega a arrancar con el valor de ejemplo.
PII_ENCRYPTION_KEY=cambiar-en-local-no-usar-fuera-de-desarrollo

# --- Puertos publicados por el borde (nginx) -------------------------------
# Solo el proxy publica puertos al host. Cambia estos valores si hay colisión.
HTTP_PORT=8080
HTTPS_PORT=18443

# --- Aplicación ---------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- URL interna del servicio de IA --------------------------------------
# El backend usa esta dirección para llamarlo desde la red del compose.
IA_URL=http://ia:8002
# Carpeta compartida: el backend escribe los pesos y el servicio ia los lee.
IA_MODELOS_DIR=./var/modelos
# Instala torch, tensorflow, ultralytics y timm dentro de la imagen de ia.
IA_INSTALAR_MODELOS=false

# --- Orígenes permitidos para requests que cambian estado (ADR-015) --------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Producción (descomenta/configura únicamente en el servidor) ----------
# DEPLOY_ENV=production
# TAILSCALE_IP=100.107.225.79
# HTTPS_PORT=18443
# PUBLIC_URL=https://100.107.225.79:18443
# ENVIRONMENT=production
# SESSION_COOKIE_SECURE=true
# ALLOWED_ORIGINS=https://100.107.225.79:18443
#
# PII_ENCRYPTION_KEY debe ser una clave real generada y guardada fuera del repo.
# S3_ACCESS_KEY y S3_SECRET_KEY también deben sustituirse por secretos reales.
# --- Respaldos cifrados (configuración del host) -------------------------
# BACKUP_KEY_FILE=/etc/optimus-thy/backup.key
# BACKUP_DIR=/var/backups/optimus-thy
# BACKUP_RETENER_DIAS=14
# BACKUP_RETENER_SEMANAS=8
# BACKUP_RETENER_MESES=6
# Copia externa opcional; configura solo si se dispone de un destino S3:
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=
# BACKUP_S3_REGION=

# Correo saliente y recuperación de contraseña
# URL pública con la que se arman los enlaces de los correos.
APP_PUBLIC_URL=https://tiroides2.andresgaibor.com
# Tope de espera del servidor SMTP, en segundos.
CORREO_TIMEOUT_SEGUNDOS=10
# Vigencia del enlace de recuperación, en minutos.
RECUPERACION_TTL_MINUTOS=30
# Solicitudes por cuenta dentro de la ventana, y tamaño de esa ventana.
RECUPERACION_MAX_SOLICITUDES=3
RECUPERACION_VENTANA_MINUTOS=15
# El servidor SMTP no va aquí: se configura desde /administrador/correo.
