# PostgreSQL development
POSTGRES_DB=optimus_thy
POSTGRES_USER=optimus
POSTGRES_PASSWORD=<set-local-postgres-password>
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://optimus:<set-local-postgres-password>@localhost:55432/optimus_thy

# 32 random bytes encoded as Base64; local secret, never commit the real value
PII_ENCRYPTION_KEY_B64=<set-local-32-byte-base64-key>

# RustFS development (local S3-compatible storage)
RUSTFS_ACCESS_KEY=<set-local-rustfs-access-key>
RUSTFS_SECRET_KEY=<set-local-rustfs-secret-key>
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# Vendor-neutral object-storage configuration consumed by the application
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=optimus-thy
S3_ACCESS_KEY=<set-local-rustfs-access-key>
S3_SECRET_KEY=<set-local-rustfs-secret-key>

# API / Web
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_URL=http://localhost:8000
