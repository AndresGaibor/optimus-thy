# PostgreSQL development
POSTGRES_DB=optimus_thy
POSTGRES_USER=optimus
POSTGRES_PASSWORD=<set-local-postgres-password>
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://optimus:<set-local-postgres-password>@localhost:5432/optimus_thy

# MinIO development (local only)
MINIO_ROOT_USER=<set-local-minio-user>
MINIO_ROOT_PASSWORD=<set-local-minio-password>
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=optimus-thy
MINIO_ACCESS_KEY=<set-local-minio-user>
MINIO_SECRET_KEY=<set-local-minio-password>

# API / Web
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_URL=http://localhost:8000
